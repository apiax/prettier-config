{
  "name": "@apiax/prettier-config",
  "version": "1.1.0",
  "description": "Apiax Shareable Prettier Configuration",
  "main": "src/index.js",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apiax/prettier-config.git"
  },
  "keywords": [
    "prettier"
  ],
  "author": "Rafael Gomes <rafael.gomes@apiax.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/apiax/prettier-config/issues"
  },
  "homepage": "https://github.com/apiax/prettier-config#readme",
  "devDependencies": {
    "husky": "~9.1.7",
    "lint-staged": "~17.1.0",
    "prettier": "~3.9.6"
  },
  "peerDependencies": {
    "prettier": "~3.9.6",
    "prettier-plugin-java": "~2.10.3",
    "prettier-plugin-organize-imports": "~4.3.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": false
    },
    "prettier-plugin-java": {
      "optional": true
    },
    "prettier-plugin-organize-imports": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "**/*.{json,js,jsx,cjs,mjs,ts,tsx,html,css,scss}": "npx prettier --write"
  }
}
